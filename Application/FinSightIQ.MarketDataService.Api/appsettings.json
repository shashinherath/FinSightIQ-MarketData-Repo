{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "MarketDb": "Host=localhost;Port=5432;Database=marketdb;Username=finsightiq;Password=finsightiq_dev",
    "Postgres": "Host=localhost;Port=5432;Database=marketdb;Username=finsightiq;Password=finsightiq_dev",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Jwt": {
    "Issuer": "finsightiq-user-service",
    "Audience": "finsightiq-clients"
  },
  "MarketData": {
    "PollingEnabled": true,
    "PollingIntervalSeconds": 60,
    "BypassMarketHoursGuard": false,
    "QuoteCacheTtlSeconds": 60,
    "SymbolCacheTtlHours": 24,
    "AlphaVantage": {
      "BaseUrl": "https://www.alphavantage.co/",
      "ApiKey": "demo",
      "TimeoutSeconds": 10
    },
    "YahooFinance": {
      "BaseUrl": "https://query1.finance.yahoo.com/",
      "TimeoutSeconds": 10
    }
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "market.price.updated",
    "RoutingKey": "market.price.updated"
  },
  "AllowedHosts": "*"
}

