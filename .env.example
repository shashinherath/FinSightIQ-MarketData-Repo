# ==============================================================================
# FinSightIQ Market Data Service — Local Environment Configuration
# ==============================================================================
# Copy this file to '.env' for local container or environment configuration:
#   cp .env.example .env
#
# DO NOT commit '.env' or real secrets to source control.
# ==============================================================================

# ASP.NET Core Runtime Mode
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5102

# PostgreSQL Database Connection (marketdb)
ConnectionStrings__MarketDb=Host=localhost;Port=5432;Database=marketdb;Username=postgres;Password=postgres_dev_password
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=marketdb;Username=postgres;Password=postgres_dev_password

# Redis Cache Configuration (60s quote TTL)
Redis__ConnectionString=localhost:6379,password=redis_dev_password,abortConnect=false

# RabbitMQ Event Broker Configuration
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
RabbitMq__Exchange=market.price.updated
RabbitMq__RoutingKey=market.price.updated

# Market Data Providers (Primary: Alpha Vantage, Fallback: Yahoo Finance)
AlphaVantage__BaseUrl=https://www.alphavantage.co/
AlphaVantage__ApiKey=YOUR_ALPHA_VANTAGE_API_KEY

YahooFinance__BaseUrl=https://query1.finance.yahoo.com/
YahooFinance__ApiKey=YOUR_YAHOO_FINANCE_API_KEY

# Background Polling & Partition Management
MarketPolling__Enabled=true
MarketPolling__IntervalSeconds=60
MarketPolling__MaxSymbolsPerCycle=5

# JWT Validation (Gateway / Direct Token Verification)
Jwt__Issuer=finsightiq
Jwt__Audience=finsightiq
Jwt__PublicKeyPem=

# Observability
Serilog__MinimumLevel__Default=Information
OTEL_EXPORTER_OTLP_ENDPOINT=

